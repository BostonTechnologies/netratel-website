---
import Marketing from '../layouts/Marketing.astro';
import Icon from '../components/Icon.astro';
import OperationsPreview from '../components/OperationsPreview.astro';
---
<Marketing>
 <section class="hero">
  <div class="container">
   <a href="/releases/" class="release-pill"><b>v0.1.2 is here</b><span>Meet the latest stable release</span><Icon name="arrow" size={12}/></a>
   <div class="hero-grid">
    <div class="hero-copy"><p class="eyebrow">Infrastructure, on your terms</p><h1>Your infrastructure.<br/>Under <span class="gradient-text">your control.</span></h1><p class="hero-description">One home for your fleet, scripts and workflows. Run NetRatel on your infrastructure. Bring AI into the work when you choose.</p><div class="hero-ctas"><a href="/docs/getting-started/quickstart/" class="button">Deploy NetRatel <Icon name="arrow" size={16}/></a><a href="/docs/" class="button button-secondary"><Icon name="book" size={15}/>Explore the docs</a></div><p class="hero-footnote"><Icon name="check" size={12}/>Open source · Self-hosted · AI optional</p></div>
    <OperationsPreview/>
   </div>
  </div>
 </section>
 <div class="platform-strip"><div class="container"><span class="strip-label">One connected workspace</span><span class="platform-item"><Icon name="monitor" size={16}/>Windows <small>x64 clients</small></span><span class="platform-item"><Icon name="terminal" size={16}/>Linux <small>x64 clients</small></span><span class="platform-item"><Icon name="monitor" size={16}/>macOS <small>Apple Silicon</small></span><span class="platform-item"><Icon name="code" size={16}/>.NET + Akka.NET</span></div></div>
 <section class="section" id="platform">
  <div class="container"><div class="section-head"><div><p class="eyebrow">The platform</p><h2>Less switching.<br/>More doing.</h2></div><p>See what is happening, run the work and follow the result. Keep the day-to-day in one operator workspace.</p></div>
   <div class="capability-grid">
    <article class="capability"><div class="capability-icon"><Icon name="server" size={22}/></div><h3>Know your fleet.</h3><p>Client health, inventory, services, logs and files. Move from a fleet-wide view to the machine that needs your attention.</p><div class="capability-chips"><span>Windows</span><span>Linux</span><span>macOS</span></div><a href="/docs/guides/clients/" class="text-link">Explore fleet management <Icon name="arrow" size={13}/></a><div class="capability-mini" aria-hidden="true">{[24,45,31,59,43,66,54,77,68,82,60,74,56,87,70,91,79,86,69,94,84,93].map(h=><i style={`height:${h}%`}></i>)}</div></article>
    <article class="capability"><div class="capability-icon"><Icon name="layers" size={22}/></div><h3>Make work repeatable.</h3><p>Build a script library. Combine steps into jobs, collect the inputs and set a schedule. Every run keeps its own result.</p><div class="inline-points"><span><Icon name="check" size={12}/>Reusable scripts and parameters</span><span><Icon name="check" size={12}/>Manual runs and schedules</span><span><Icon name="check" size={12}/>Step-by-step execution output</span></div><a href="/docs/guides/jobs/" class="text-link">Build your first job <Icon name="arrow" size={13}/></a></article>
    <article class="capability"><div class="capability-icon"><Icon name="terminal" size={22}/></div><h3>Get closer to the issue.</h3><p>Open a remote terminal, inspect a log or run a targeted check. Work from the browser or bring your own command-line tools.</p><div class="mini-terminal"><span>$</span> netratel doctor<br/><span>✓</span> profile and connection checks<br/><span>$</span> netratel clients-v2 --help</div><a href="/docs/guides/terminal-and-services/" class="text-link">Explore operator tools <Icon name="arrow" size={13}/></a></article>
   </div>
  </div>
 </section>
 <section class="section workflow-section">
  <div class="container workflow-grid"><div class="workflow-copy"><p class="eyebrow">Monitoring & workflows</p><h2>An alert should lead somewhere useful.</h2><p>Watch CPU, disks and services. Route an alert through a reviewed flow to the people and tools that can act on it.</p><p>Create a RatelDesk ticket, send a Slack or Discord notification, or bring Netclaw into an investigation—with the tenant and context attached.</p><a class="text-link" href="/docs/guides/flows/">See how alert flows work <Icon name="arrow" size={15}/></a></div><div class="workflow-visual" role="img" aria-label="A monitoring alert enters a published flow, optionally runs a Netclaw investigation, then reaches configured actions such as RatelDesk, Slack or Discord."><div class="workflow-title"><span>From signal to next step</span><Icon name="flow" size={15}/></div><div class="workflow-origin"><Icon name="activity" size={23}/><div>A monitoring rule fires<small>Client · Tenant · Alert context</small></div></div><div class="flow-connector"></div><div class="flow-node">Published flow</div><div class="flow-connector"></div><div class="flow-node">Netclaw investigation · Optional</div><div class="flow-connector"></div><div class="flow-branches"><div class="flow-destination">RatelDesk<small>Create a ticket</small></div><div class="flow-destination">Slack<small>Notify the team</small></div><div class="flow-destination">Discord<small>Send a notification</small></div></div><p class="flow-legend">Choose the destinations. Preview the mapping. Publish when it is ready.</p></div></div>
 </section>
 <section class="section" id="integrations">
  <div class="container"><div class="integrations-intro"><div class="integrations-copy"><p class="eyebrow">Connected by design</p><h2>Your tools.<br/>Your access rules.</h2><p>Connect assistants through HTTP MCP or a local stdio process. Use Netclaw for tenant conversations and investigations. Keep credentials, permissions and approvals under your control.</p><a href="/docs/integrations/overview/" class="text-link">Find your integration path <Icon name="arrow" size={15}/></a></div><div class="integration-list"><a class="integration-tile" href="/docs/integrations/netclaw/"><Icon name="spark" size={23}/><div><h3>Netclaw</h3><p>Chat & investigations</p></div><span>↗</span></a><a class="integration-tile" href="/docs/integrations/http-mcp/"><Icon name="globe" size={23}/><div><h3>HTTP MCP</h3><p>Remote assistant access</p></div><span>↗</span></a><a class="integration-tile" href="/docs/integrations/stdio/"><Icon name="terminal" size={23}/><div><h3>stdio MCP</h3><p>Local tooling & bridge</p></div><span>↗</span></a><a class="integration-tile" href="/docs/integrations/rateldesk/"><Icon name="layers" size={23}/><div><h3>RatelDesk</h3><p>Alerts to service delivery</p></div><span>↗</span></a></div></div><div class="auth-strip"><div><Icon name="shield" size={23}/><div>Sign in the way your team works.<p>Built-in local accounts, OpenID Connect or both.</p></div></div><div class="auth-links"><a href="/docs/identity/local/">Local</a><a href="/docs/identity/oidc/">OIDC</a><a href="/docs/identity/hybrid/">Hybrid</a></div></div></div>
 </section>
 <section class="section start-section" id="get-started">
  <div class="container start-grid"><div class="start-copy"><p class="eyebrow">Start here</p><h2>A clear path<br/>to your first run.</h2><p>Start with a server. Add a client. Build from there.</p><div class="start-options" role="tablist" aria-label="Getting started paths"><button role="tab" id="start-tab-server" aria-controls="start-server" aria-selected="true" data-start="server"><Icon name="server" size={18}/>Deploy a server<Icon name="arrow" size={13}/></button><button role="tab" id="start-tab-client" aria-controls="start-client" aria-selected="false" data-start="client" tabindex="-1"><Icon name="monitor" size={18}/>Connect a client<Icon name="arrow" size={13}/></button><button role="tab" id="start-tab-mcp" aria-controls="start-mcp" aria-selected="false" data-start="mcp" tabindex="-1"><Icon name="spark" size={18}/>Connect an assistant<Icon name="arrow" size={13}/></button></div></div>
  <div>
   <div class="start-panel" id="start-server" role="tabpanel" aria-labelledby="start-tab-server" tabindex="0"><div class="start-panel-head"><span>01 / SERVER</span><span>Linux x64 · Docker Compose</span></div><div class="start-panel-body"><h3>Start with the stable release.</h3><p>The Compose bundle includes the server stack and pinned image digests. Download it, verify the checksum, then follow the setup guide.</p><div class="command"><code id="download-command">curl -fLO https://github.com/BostonTechnologies/netratel/releases/download/v0.1.2/netratel-compose-0.1.2.tar.gz</code><button class="copy-command" data-copy="download-command" aria-label="Copy download command"><Icon name="copy" size={15}/></button></div><p class="start-note">The quickstart covers verification, configuration, signing keys and your first administrator.</p><a href="/docs/getting-started/quickstart/" class="text-link">Follow the deployment guide <Icon name="arrow" size={14}/></a></div></div>
   <div class="start-panel" id="start-client" role="tabpanel" aria-labelledby="start-tab-client" tabindex="0" hidden><div class="start-panel-head"><span>02 / CLIENT</span><span>Windows · Linux · macOS</span></div><div class="start-panel-body"><h3>Connect your first computer.</h3><p>Set the public site and gateway addresses. Import the release client pack, then generate a protected installer for the right tenant.</p><div class="mini-terminal"><span>1.</span> Configure Site URL + Gateway URL<br/><span>2.</span> Import the release client pack<br/><span>3.</span> Clients → Artifacts → Generate script</div><p class="start-note">The client joins your tenant and appears in the fleet after enrolment.</p><a href="/docs/getting-started/first-client/" class="text-link">Connect your first client <Icon name="arrow" size={14}/></a></div></div>
   <div class="start-panel" id="start-mcp" role="tabpanel" aria-labelledby="start-tab-mcp" tabindex="0" hidden><div class="start-panel-head"><span>03 / ASSISTANT</span><span>Scoped tools · Explicit access</span></div><div class="start-panel-body"><h3>Give your assistant a defined role.</h3><p>Choose remote HTTP MCP or a local stdio connection. Configure a separate credential for each consumer and review its tenant access.</p><div class="mini-terminal"><span>HTTP</span>  Assistant → /mcp → NetRatel API<br/><span>stdio</span> Assistant → local process → NetRatel API</div><p class="start-note">Start with authentication status and a permitted read before enabling actions.</p><a href="/docs/integrations/overview/" class="text-link">Choose an MCP connection <Icon name="arrow" size={14}/></a></div></div>
  </div></div>
 </section>
 <section class="section"><div class="container"><div class="section-head"><div><p class="eyebrow">Documentation that gets to the point</p><h2>Find the next thing you need.</h2></div><a href="/docs/" class="text-link">Browse all documentation <Icon name="arrow" size={14}/></a></div><div class="doc-paths"><a class="doc-path" href="/docs/deployment/overview/"><span>01 / DEPLOY</span><h3>Run it your way.</h3><p>Compose, HTTPS, external PostgreSQL and reverse proxies. Choose the setup that fits your environment.</p><span class="text-link">Deployment scenarios <Icon name="arrow" size={13}/></span></a><a class="doc-path" href="/docs/guides/jobs/"><span>02 / OPERATE</span><h3>Turn a task into a routine.</h3><p>Manage clients, write scripts and schedule jobs. Follow output from the first step to the final result.</p><span class="text-link">Operator guides <Icon name="arrow" size={13}/></span></a><a class="doc-path" href="/docs/reference/architecture/"><span>03 / UNDERSTAND</span><h3>See how it fits together.</h3><p>Understand the architecture, identity model and integration boundaries before extending your setup.</p><span class="text-link">Architecture & reference <Icon name="arrow" size={13}/></span></a></div></div></section>
 <section class="cta-section"><div class="container cta-panel"><div><p class="eyebrow">Built by Boston Technologies</p><h2>Own the way you operate.</h2><p>Deploy NetRatel. Connect your first client. Make the next task easier.</p><div class="cta-actions"><a class="button" href="/docs/getting-started/quickstart/">Get started <Icon name="arrow" size={15}/></a><a class="button button-secondary" href="https://github.com/BostonTechnologies/netratel">View on GitHub <Icon name="arrowUp" size={14}/></a></div></div><img class="cta-art" src="/brand/netratel-mark-512.webp" width="512" height="512" alt="NetRatel honey badger mascot" loading="lazy"/></div></section>
</Marketing>
<script>
 const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-start]'));
 function activate(tab: HTMLButtonElement) { for(const t of tabs){ const selected=t===tab;t.setAttribute('aria-selected',String(selected));t.tabIndex=selected?0:-1;const pane=document.getElementById(`start-${t.dataset.start}`);if(pane)pane.hidden=!selected;} }
 tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>activate(tab));tab.addEventListener('keydown',e=>{if(['ArrowRight','ArrowLeft','ArrowDown','ArrowUp','Home','End'].includes(e.key)){e.preventDefault();const index=e.key==='Home'?0:e.key==='End'?tabs.length-1:(i+(['ArrowRight','ArrowDown'].includes(e.key)?1:-1)+tabs.length)%tabs.length;activate(tabs[index]);tabs[index].focus();}});});
 document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => button.addEventListener('click', async()=>{const code=document.getElementById(button.dataset.copy||'')?.textContent;if(!code)return;try{await navigator.clipboard.writeText(code);button.setAttribute('aria-label','Command copied');button.innerHTML='<span style="font-size:10px">Copied</span>';setTimeout(()=>{button.setAttribute('aria-label','Copy download command');button.innerHTML='<span style="font-size:10px">Copy</span>';},1800);}catch{const selection=window.getSelection();const range=document.createRange();const source=document.getElementById(button.dataset.copy||'');if(source){range.selectNodeContents(source);selection?.removeAllRanges();selection?.addRange(range);button.setAttribute('aria-label','Select and copy the command');}}}));
</script>
