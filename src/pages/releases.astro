---
import Marketing from '../layouts/Marketing.astro';
import Icon from '../components/Icon.astro';
import release from '../data/release.json';
const asset = (name: string) => release.assets.find(a => a.name === name)!;
const groups = [
 { title: 'Server', icon: 'server', platform: 'Linux x64 · Docker Compose', description: 'Web, API, migrations, database and optional MCP deployment configuration.', name: 'netratel-compose-0.1.2.tar.gz', guide: '/docs/getting-started/quickstart/' },
 { title: 'Windows client', icon: 'monitor', platform: 'Windows x64 · Self-contained', description: 'Native Windows archive. Use the release client-pack workflow to generate a protected installer.', name: 'netratel-client-0.1.2-win-x64.zip', guide: '/docs/getting-started/first-client/' },
 { title: 'Linux client', icon: 'terminal', platform: 'Linux x64 · Self-contained', description: 'Native client archive with the Linux terminal helper.', name: 'netratel-client-0.1.2-linux-x64.tar.gz', guide: '/docs/getting-started/first-client/' },
 { title: 'macOS client', icon: 'monitor', platform: 'Apple Silicon · Self-contained', description: 'Native client for macOS arm64 computers.', name: 'netratel-client-0.1.2-osx-arm64.tar.gz', guide: '/docs/getting-started/first-client/' },
 { title: 'Command-line tools', icon: 'code', platform: 'Linux x64 · .NET 10', description: 'Profile setup, connection checks and scoped operator commands.', name: 'netratel-cli-0.1.2-linux-x64.tar.gz', guide: '/docs/reference/cli/' },
 { title: 'MCP stdio & HTTP bridge', icon: 'globe', platform: 'Linux or Windows x64 · .NET 10', description: 'Connect a local MCP host directly or bridge it to your HTTP MCP endpoint.', name: 'netratel-mcp-stdio-0.1.2-linux-x64.tar.gz', alternate: 'netratel-mcp-stdio-0.1.2-win-x64.zip', guide: '/docs/integrations/stdio/' },
];
---
<Marketing title="NetRatel releases & downloads — v0.1.2" description="Download NetRatel v0.1.2: the Compose server bundle, native Windows, Linux and macOS clients, CLI and MCP tools.">
 <section class="release-hero container"><p class="eyebrow">Releases & downloads</p><div class="release-title"><h1>Ready for your<br/><span>infrastructure.</span></h1><div class="release-meta"><b>v0.1.2</b><span>Stable release</span><time datetime="2026-10-29">29 October 2026</time></div></div><p>Get the matching server bundle, clients and operator tools. These guides and downloads all target NetRatel 0.1.2.</p><div class="hero-ctas"><a class="button" href={asset('netratel-compose-0.1.2.tar.gz').url}><Icon name="download" size={17}/>Download server bundle</a><a class="button button-secondary" href="/docs/getting-started/quickstart/">Installation guide <Icon name="arrow" size={16}/></a></div></section>
 <section class="container release-highlights"><div><p class="eyebrow">In this release</p><h2>A more connected<br/>operator workspace.</h2></div><ul><li><strong>General Netclaw chat</strong><span>Tenant conversations with saved history, starter prompts and copyable code.</span></li><li><strong>Clearer fleet navigation</strong><span>Compact tenant selection, direct online/offline views and improved client filtering.</span></li><li><strong>Guided integration access</strong><span>Create HTTP MCP credentials and review tenant permissions and operator policies.</span></li><li><strong>Optional Windows computer use</strong><span>Permission-controlled observation and input for selected applications.</span></li></ul></section>
 <section class="section container"><div class="section-head"><div><p class="eyebrow">Choose your download</p><h2>The right tools for your setup.</h2></div><a class="text-link" href="/docs/getting-started/requirements/">Supported platforms <Icon name="arrow" size={14}/></a></div><div class="download-grid">{groups.map(group => <article class="download-card"><Icon name={group.icon} size={24}/><p class="download-platform">{group.platform}</p><h3>{group.title}</h3><p>{group.description}</p><div class="download-actions"><a href={asset(group.name).url} class="text-link"><Icon name="download" size={14}/>{group.alternate ? 'Linux' : 'Download'}<span class="file-size">{(asset(group.name).bytes/1024/1024).toFixed(1)} MB</span></a>{group.alternate && <a class="text-link" href={asset(group.alternate).url}><Icon name="download" size={14}/>Windows</a>}</div><a class="download-guide" href={group.guide}>Setup instructions <Icon name="arrow" size={12}/></a></article>)}</div></section>
 <section class="container release-integrity"><div><Icon name="shield" size={24}/><h2>Verify what you install.</h2><p>Check the archive against SHA256SUMS. The publication record lists the released assets and immutable container image digests.</p></div><div class="integrity-links"><a href={asset('SHA256SUMS').url}>SHA256 checksums <Icon name="arrowUp" size={14}/></a><a href={asset('publication.json').url}>Publication record <Icon name="arrowUp" size={14}/></a><a href={asset('netratel-0.1.2.spdx.json').url}>Software bill of materials <Icon name="arrowUp" size={14}/></a><a href={asset('NetRatel.Cli.0.1.2.nupkg').url}>CLI .NET tool package <Icon name="arrowUp" size={14}/></a><a href={release.url}>All 15 release assets <Icon name="arrowUp" size={14}/></a></div></section>
 <section class="section container release-next"><div><h2>Already using NetRatel?</h2><p>Keep the server, client packages and tool versions aligned. The upgrade guide covers your configuration, persistent state and release checks.</p><a href="/docs/deployment/upgrades/" class="text-link">Upgrade your installation <Icon name="arrow" size={15}/></a></div><div><a class="text-link" href="https://github.com/BostonTechnologies/netratel/blob/v0.1.2/docs/release-notes/0.1.2.md">Full v0.1.2 release notes <Icon name="arrowUp" size={14}/></a><a class="text-link" href="https://github.com/BostonTechnologies/netratel/releases">Previous releases <Icon name="arrowUp" size={14}/></a></div></section>
</Marketing>
<style>
.release-hero{padding:70px 0 65px}.release-title{display:flex;align-items:center;justify-content:space-between;gap:35px}.release-title h1{font:500 clamp(42px,5vw,67px)/1.1 var(--display);letter-spacing:-.055em;margin:0}.release-title h1 span{color:var(--cyan)}.release-hero>p:not(.eyebrow){font-size:14px;line-height:1.85;color:var(--muted);max-width:540px;margin:25px 0}.release-meta{display:flex;flex-direction:column;gap:10px;text-align:right}.release-meta b{font:500 40px var(--display);color:var(--cyan)}.release-meta span{font-size:11px;color:#b7cfdf}.release-meta time{font:10px var(--mono);color:#6f89a8}.release-highlights{border-block:1px solid var(--line);padding-block:42px;display:grid;grid-template-columns:1fr 1.5fr;gap:60px}.release-highlights h2,.release-integrity h2,.release-next h2{font:500 29px/1.2 var(--display);letter-spacing:-.035em;margin:0}.release-highlights ul{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:26px}.release-highlights li strong{display:block;font-size:12px;font-weight:550;margin-bottom:7px}.release-highlights li span{font-size:11px;line-height:1.8;color:#859bb5}.download-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.download-card{padding:26px;border:1px solid var(--line);border-radius:8px;background:#0f1825;display:flex;flex-direction:column}.download-card>svg{color:var(--cyan);margin-bottom:18px}.download-platform{font:9px var(--mono)!important;color:#7593b2!important}.download-card h3{font:500 22px var(--display);margin:0 0 12px;letter-spacing:-.03em}.download-card p{font-size:12px;line-height:1.8;color:#8ea4bd;margin:0 0 16px}.download-actions{display:flex;gap:15px;flex-wrap:wrap;margin-top:auto;padding-top:9px}.download-actions .text-link{font-size:11px}.file-size{font:9px var(--mono);color:#66849f}.download-guide{display:flex;gap:6px;align-items:center;font-size:10px;color:#819bb7;padding-top:18px;border-top:1px solid var(--line);margin-top:18px}.release-integrity{border:1px solid #5ae5ed20;background:#0e1b28;border-radius:9px;padding:32px 35px;display:grid;grid-template-columns:1.2fr 1fr;gap:60px}.release-integrity>div>svg{color:var(--cyan);margin-bottom:15px}.release-integrity h2{font-size:24px}.release-integrity p,.release-next p{font-size:12px;line-height:1.8;color:#8fa7c2;max-width:460px;margin:15px 0 0}.integrity-links{display:flex;flex-direction:column;justify-content:center;gap:16px}.integrity-links a{display:flex;gap:12px;align-items:center;color:#9bccdb;font-size:11px}.release-next{display:grid;grid-template-columns:1.5fr 1fr;gap:80px}.release-next p{margin-bottom:24px}.release-next>div:last-child{display:flex;flex-direction:column;gap:25px;justify-content:center}.release-next .text-link{font-size:12px}@media(max-width:760px){.release-hero{padding:42px 0}.release-title{align-items:start}.release-meta b{font-size:26px}.release-meta span,.release-meta time{font-size:9px}.release-highlights{grid-template-columns:1fr;gap:30px}.release-highlights ul{gap:24px}.download-grid{grid-template-columns:1fr}.release-integrity{grid-template-columns:1fr;gap:25px;padding:27px}.release-next{grid-template-columns:1fr;gap:35px}.release-title h1{font-size:40px}.release-hero .hero-ctas{flex-wrap:wrap}}
</style>
